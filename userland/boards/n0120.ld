  InternalFlashOrigin = 0x08000000;
  InternalFlashLength = 0x80000;
  STBootloaderAddress = 0x1FF00000;
  BootloaderOrigin = InternalFlashOrigin;
  PseudoOTPLength = 512;
  TrampolineLength = 0x400;
  BootloaderLength = InternalFlashLength - PseudoOTPLength - TrampolineLength;
  PseudoOTPOrigin = BootloaderOrigin + BootloaderLength;
  TrampolineOrigin = PseudoOTPOrigin + PseudoOTPLength;
  ExternalFlashOrigin = 0x90000000;
  ExternalFlashLength = 0x800000;
  StandardExternalFlashSectorLength = 0x10000;
  SlotAOffset = 0;
  SlotAOrigin = ExternalFlashOrigin + SlotAOffset;
  SlotBOffset = ExternalFlashLength / 2;
  SlotBOrigin = ExternalFlashOrigin + SlotBOffset;
  PersistingBytesLength = StandardExternalFlashSectorLength;
  PersistingBytesVirtualOrigin = ExternalFlashOrigin + ExternalFlashLength / 2 - PersistingBytesLength;
  DeviceNameSectorLength = 1024;
  KernelLength = StandardExternalFlashSectorLength;
  KernelVirtualOrigin = ExternalFlashOrigin;
  ExtraDataLength = 0;
  ExtraDataVirtualOrigin = KernelVirtualOrigin + KernelLength;
  UserlandLength = ExternalFlashLength / 2 - KernelLength - ExtraDataLength - PersistingBytesLength;
  UserlandVirtualOrigin = ExtraDataVirtualOrigin + ExtraDataLength;
  ExternalAppsSectorUnit = 0x10000;
  SRAMOrigin = 0x24000000;
  SRAMLength = 0x40000;
  KernelStackLength = 0x400;
  KernelDataBSSLength = 0xC00;
  KernelSRAMLength = KernelStackLength + KernelDataBSSLength;
  KernelSRAMOrigin = SRAMOrigin + SRAMLength - KernelSRAMLength;
  UserlandStackLength = 0x8000;
  UserlandSRAMOrigin = SRAMOrigin;
  UserlandSRAMLength = SRAMLength - KernelSRAMLength;
  STBootloaderStack = 0x8000;
  FlasherLength = 0x10000;
  FlasherOffset = SRAMLength - FlasherLength;
ASSERT(STBootloaderStack < FlasherOffset, "The flasher overlaps ST bootloader stack.");
  SignedBinaryOffset = 0;
  BenchLength = 0x20000;
  BackupSRAMOrigin = 0x38800000;
  BackupSRAMLength = 0x1000;
  SignedPayloadLength = 8;
  CanaryLength = 4;
  SingleSignatureLength = 64;
  NumberOfSignatures = 16;
  SignatureLength = SingleSignatureLength * NumberOfSignatures;
  NumberOfMPUSectors = 8;
